# Discord
DISCORD_TOKEN=your_bot_token_here
DISCORD_GUILD_ID=your_guild_id_here

# Google Calendar (bot polls for Cal.com bookings — no service account needed)
# Get these from console.cloud.google.com → your project → APIs & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_POLL_SECONDS=60

# Only set this if you're on a custom/white-labeled Cal.com domain (default: cal.com)
CAL_BOOKING_DOMAIN=cal.com

# Role IDs (filled in after setup.js runs)
ROLE_FOUNDER_ID=
ROLE_CLOSER_ID=
ROLE_SETTER_ID=
ROLE_FULFILLMENT_ID=
ROLE_BOT_ID=

# Channel IDs (filled in after setup.js runs)
CHANNEL_LEAD_INTAKE_ID=
CHANNEL_SETTER_DESK_ID=
CHANNEL_DEALS_FORUM_ID=
CHANNEL_BOOKED_CALLS_ID=
CHANNEL_WINS_ID=
CHANNEL_WON_HANDOFF_ID=
CHANNEL_ANNOUNCEMENTS_ID=
CHANNEL_DAILY_INTENTIONS_ID=
CHANNEL_PLAYBOOKS_ID=

# Speed-to-lead SLA (minutes)
SLA_PING_SETTER_MIN=5
SLA_PING_CLOSER_MIN=10
SLA_PING_FOUNDER_MIN=15

# Coverage hours (24h, server timezone)
COVERAGE_START_HOUR=9
COVERAGE_END_HOUR=22
COVERAGE_TIMEZONE=Europe/Brussels

# Server port for the manual /lead intake endpoint
WEBHOOK_PORT=3000
